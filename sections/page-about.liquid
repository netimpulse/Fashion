{% comment %}
  About us page section: complete brand story page in one click —
  hero, story rows, quote, newsletter. Built from theme blocks.
{% endcomment %}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .about-page {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div class="about-page section-pad color-scheme color-{{ scheme.id }}">
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:sections.about.name",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:sections.about.name",
      "blocks": [
        {
          "type": "hero",
          "settings": {
            "height": "medium",
            "content_position": "center",
            "eyebrow": "t:sections.about.hero_eyebrow",
            "heading": "t:sections.about.hero_heading",
            "button_label": ""
          }
        },
        { "type": "image-with-text" },
        {
          "type": "image-with-text",
          "settings": {
            "layout": "right"
          }
        },
        { "type": "quote" },
        { "type": "newsletter" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
