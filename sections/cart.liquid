{% comment %}
  Cart page: two-column layout (items + sticky summary), AJAX updates via
  <cart-items> (assets/cart.js), full no-JS fallback through the form.
  Styles: assets/component-cart.css + assets/section-cart.css
{% endcomment %}

{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'section-cart.css' | asset_url | stylesheet_tag }}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .cart-page {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="cart-page section-pad color-scheme color-{{ scheme.id }}" data-cart-section>
  <div class="page-width">
    <header class="cart-page__header">
      <h1 class="cart-page__title">
        {{ 'cart.title' | t }}
        <sup class="cart-page__count">{{ cart.item_count }}</sup>
      </h1>
      <a href="{{ routes.all_products_collection_url }}" class="link-arrow">
        {{ 'cart.continue_shopping' | t }}
        {% render 'icon', icon: 'arrow-right' %}
      </a>
    </header>

    <p class="form-status form-status--error" data-cart-error role="alert" hidden></p>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page__layout">
        <cart-items class="cart-page__items">
          <div class="cart-page__columns" aria-hidden="true">
            <span>{{ 'cart.headings.product' | t }}</span>
            <span>{{ 'cart.headings.total' | t }}</span>
          </div>
          {%- for item in cart.items -%}
            {% render 'cart-line-item', item: item, line: forloop.index, layout: 'page' %}
          {%- endfor -%}
        </cart-items>

        <aside class="cart-page__summary">
          <h2 class="cart-page__summary-title">{{ 'cart.summary' | t }}</h2>

          {% render 'free-shipping-bar' %}

          {%- if settings.cart_show_note -%}
            <details class="cart-page__note">
              <summary class="cart-page__note-summary">
                {{ 'cart.note' | t }}
                {% render 'icon', icon: 'chevron-down' %}
              </summary>
              <label for="CartNote" class="visually-hidden">{{ 'cart.note' | t }}</label>
              <textarea
                id="CartNote"
                name="note"
                class="cart-page__note-input"
                placeholder="{{ 'cart.note_placeholder' | t }}"
                data-cart-note
              >{{ cart.note }}</textarea>
            </details>
          {%- endif -%}

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cart-page__discounts" role="list">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="cart-page__discount text-small">
                  {{ discount.title }} (-{{ discount.total_allocated_amount | money }})
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="cart-page__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-page__taxes text-small">{{ 'cart.taxes_and_shipping' | t }}</p>

          <button type="submit" name="update" class="btn btn--secondary btn--full cart-page__update">
            {{ 'cart.update' | t }}
          </button>
          <button type="submit" name="checkout" class="btn btn--full">
            {{ 'cart.checkout' | t }}
          </button>

          {%- if shop.enabled_payment_types.size > 0 -%}
            <ul class="cart-page__payment" role="list" aria-label="{{ 'general.payment.method_labels' | t }}">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'cart-page__payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </aside>
      </form>
    {%- else -%}
      <div class="cart-page__empty">
        <p class="h2">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn">
          {{ 'cart.continue_shopping' | t }}
        </a>
        {%- if shop.customer_accounts_enabled and customer == null -%}
          <p class="text-small">
            {{ 'cart.login.title' | t }}
            <a href="{{ routes.account_login_url }}">{{ 'cart.login.link' | t }}</a>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
