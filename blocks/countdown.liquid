{% doc %}
  Drop countdown block: deadline timer with optional background image and CTA.
  JS: assets/countdown.js (custom element <count-down>).
{% enddoc %}

<script src="{{ 'countdown.js' | asset_url }}" defer></script>

{%- liquid
  assign scheme = block.settings.color_scheme
  assign deadline = block.settings.date | strip
  if block.settings.time != blank
    assign deadline = deadline | append: 'T' | append: block.settings.time
  else
    assign deadline = deadline | append: 'T00:00'
  endif
  assign has_image = false
  if block.settings.image != blank
    assign has_image = true
  endif
-%}

<div
  class="countdown{% if has_image %} countdown--image{% else %} color-scheme color-{{ scheme.id }}{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if has_image -%}
    <div class="countdown__media">
      {%- assign cd_alt = block.settings.image.alt | default: block.settings.heading | escape -%}
      {{
        block.settings.image
        | image_url: width: 2400
        | image_tag: alt: cd_alt, class: 'countdown__image', loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400'
      }}
    </div>
  {%- endif -%}

  <div class="countdown__content page-width">
    {%- if block.settings.eyebrow != blank -%}
      <p class="eyebrow" data-reveal>{{ block.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if block.settings.heading != blank -%}
      <h2 class="countdown__heading h1" data-reveal>{{ block.settings.heading | escape }}</h2>
    {%- endif -%}

    <count-down
      class="countdown__timer"
      data-deadline="{{ deadline | escape }}"
      data-finished-behavior="{{ block.settings.finished_behavior }}"
      data-reveal
    >
      <div class="countdown__units" data-countdown-units>
        <div class="countdown__unit">
          <span class="countdown__value" data-cd-days>00</span>
          <span class="countdown__label">{{ 'general.countdown.days' | t }}</span>
        </div>
        <span class="countdown__sep" aria-hidden="true">:</span>
        <div class="countdown__unit">
          <span class="countdown__value" data-cd-hours>00</span>
          <span class="countdown__label">{{ 'general.countdown.hours' | t }}</span>
        </div>
        <span class="countdown__sep" aria-hidden="true">:</span>
        <div class="countdown__unit">
          <span class="countdown__value" data-cd-minutes>00</span>
          <span class="countdown__label">{{ 'general.countdown.minutes' | t }}</span>
        </div>
        <span class="countdown__sep" aria-hidden="true">:</span>
        <div class="countdown__unit">
          <span class="countdown__value" data-cd-seconds>00</span>
          <span class="countdown__label">{{ 'general.countdown.seconds' | t }}</span>
        </div>
      </div>
      <p class="countdown__finished h3" data-countdown-finished hidden>
        {{ block.settings.finished_message | escape }}
      </p>
    </count-down>

    {%- if block.settings.button_label != blank -%}
      <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="btn countdown__btn" data-reveal>
        {{ block.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .countdown {
    position: relative;
    overflow: hidden;
    display: flex;
  }

  .countdown__media {
    position: absolute;
    inset: 0;
  }

  .countdown__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .countdown--image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.45);
  }

  .countdown--image .countdown__content {
    color: #ffffff;
  }

  .countdown__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .countdown__heading {
    margin: 0;
  }

  .countdown__units {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-width: 3.2em;
  }

  .countdown__value {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2.2rem, 7vw, 4.5rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .countdown__sep {
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 5vw, 3.2rem);
    opacity: 0.5;
  }

  .countdown__label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .countdown__btn {
    margin-block-start: 0.75rem;
  }

  .countdown--image .countdown__btn {
    --btn-bg: #ffffff;
    --btn-text: #111111;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.countdown.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "t:blocks.countdown.eyebrow_default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:blocks.countdown.heading_default"
    },
    {
      "type": "text",
      "id": "date",
      "label": "t:blocks.countdown.date",
      "info": "t:blocks.countdown.date_info",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "time",
      "label": "t:blocks.countdown.time",
      "info": "t:blocks.countdown.time_info",
      "default": "20:00"
    },
    {
      "type": "select",
      "id": "finished_behavior",
      "label": "t:blocks.countdown.finished_behavior",
      "options": [
        { "value": "hide", "label": "t:blocks.countdown.finished_hide" },
        { "value": "message", "label": "t:blocks.countdown.finished_message_opt" }
      ],
      "default": "message"
    },
    {
      "type": "text",
      "id": "finished_message",
      "label": "t:blocks.countdown.finished_message",
      "default": "t:blocks.countdown.finished_default"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:blocks.hero.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:blocks.hero.button_link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.countdown.name"
    }
  ]
}
{% endschema %}
