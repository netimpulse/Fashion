{% doc %}
  Container for collapsible info sections (Beschreibung, Material,
  Versand & Rückgabe, etc.). Each item is its own block — merchants can add,
  remove, and reorder items freely in the editor.

  @example
  {% content_for 'block', type: 'product-accordion', id: 'accordion' %}
{% enddoc %}

<div
  class="pdp-accordion"
  {% if block.settings.exclusive %}data-accordion-exclusive{% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="pdp-accordion__heading">{{ block.settings.heading }}</p>
  {%- endif -%}

  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:blocks.accordion.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.accordion.settings.heading"
    },
    {
      "type": "checkbox",
      "id": "exclusive",
      "label": "t:blocks.accordion.settings.exclusive",
      "default": false,
      "info": "t:blocks.accordion.settings.exclusive_info"
    }
  ],
  "blocks": [
    { "type": "accordion-item" }
  ],
  "presets": [
    {
      "name": "t:blocks.accordion.name",
      "blocks": [
        {
          "type": "accordion-item",
          "settings": {
            "title": "Beschreibung",
            "content": "<p>Hier kannst du deine Produktbeschreibung einfügen.</p>"
          }
        },
        {
          "type": "accordion-item",
          "settings": {
            "title": "Material & Pflege",
            "content": "<p>100% Baumwolle. Maschinenwäsche bei 30°.</p>"
          }
        },
        {
          "type": "accordion-item",
          "settings": {
            "title": "Lieferung & Rücksendung",
            "content": "<p>Kostenlose Lieferung ab 75 €. 14 Tage Rückgaberecht.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
