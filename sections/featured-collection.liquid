{%- liquid
  assign section_id = section.id
  assign collection = collections[section.settings.collection]
  assign product_limit = section.settings.product_limit
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign layout = section.settings.layout
  assign accent_color = section.settings.accent_color
  assign style_dark = section.settings.style_dark_mode
  assign show_view_all = section.settings.show_view_all
  assign show_vendor = section.settings.show_vendor
  assign show_quick_add = section.settings.show_quick_add
-%}

{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
{%- if layout == 'carousel' -%}
  <script src="{{ 'featured-collection.js' | asset_url }}" defer></script>
{%- endif -%}

{% style %}
  #shopify-section-{{ section_id }} {
    --fc-pad-top: {{ section.settings.padding_top }}px;
    --fc-pad-bottom: {{ section.settings.padding_bottom }}px;
    --fc-cols-desktop: {{ columns_desktop }};
    --fc-cols-mobile: {{ columns_mobile }};
    --fc-accent: {{ accent_color.red }} {{ accent_color.green }} {{ accent_color.blue }};
  }
{% endstyle %}

<section
  class="featured-collection full-width{% if style_dark %} featured-collection--dark{% endif %}{% if layout == 'carousel' %} featured-collection--carousel{% endif %}"
  id="featured-collection-{{ section_id }}"
  data-section-id="{{ section_id }}"
  data-section-type="featured-collection"
>
  <div class="featured-collection__container">
    <header class="featured-collection__header">
      <div class="featured-collection__heading-group">
        {%- if section.settings.eyebrow != blank -%}
          <p class="featured-collection__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="featured-collection__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      {%- if show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="featured-collection__view-all">
          <span>{{ 'sections.featured_collection.view_all' | t }}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      {%- endif -%}
    </header>

    {%- if collection != blank and collection.products_count > 0 -%}
      {%- if layout == 'carousel' -%}
        <featured-carousel class="featured-collection__carousel" data-section-id="{{ section_id }}">
          <div class="featured-collection__track" data-track tabindex="0" role="region" aria-label="{{ section.settings.heading | default: 'Products' | escape }}">
            {%- for product in collection.products limit: product_limit -%}
              <div class="featured-collection__slot">
                {%- render 'product-card',
                  product: product,
                  card_class: 'product-card--carousel',
                  show_vendor: show_vendor,
                  show_quick_add: show_quick_add
                -%}
              </div>
            {%- endfor -%}
          </div>

          <div class="featured-collection__nav">
            <button type="button" class="featured-collection__nav-btn" data-carousel-prev aria-label="{{ 'sections.featured_collection.prev' | t }}">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                <path d="m15 6-6 6 6 6"></path>
              </svg>
            </button>
            <button type="button" class="featured-collection__nav-btn" data-carousel-next aria-label="{{ 'sections.featured_collection.next' | t }}">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                <path d="m9 6 6 6-6 6"></path>
              </svg>
            </button>
          </div>
        </featured-carousel>
      {%- else -%}
        <div class="featured-collection__grid">
          {%- for product in collection.products limit: product_limit -%}
            {%- render 'product-card',
              product: product,
              card_class: 'product-card--grid',
              show_vendor: show_vendor,
              show_quick_add: show_quick_add
            -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- elsif collection != blank -%}
      <p class="featured-collection__empty">{{ 'sections.featured_collection.empty' | t }}</p>
    {%- else -%}
      <div class="featured-collection__grid featured-collection__grid--placeholder">
        {%- for i in (1..product_limit) -%}
          <article class="product-card product-card--placeholder">
            <div class="product-card__media">
              {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
            </div>
            <div class="product-card__body">
              <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="product-card__price">
                <span class="product-card__price-current">{{ 4900 | money }}</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.headers.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.featured_collection.settings.eyebrow.label",
      "default": "Drop 03"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collection.settings.heading.label",
      "default": "Latest Drop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.featured_collection.settings.subheading.label",
      "default": "Heavyweight basics built for the streets."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.headers.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.settings.layout.label",
      "options": [
        { "value": "grid", "label": "t:sections.featured_collection.settings.layout.options.grid" },
        { "value": "carousel", "label": "t:sections.featured_collection.settings.layout.options.carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:sections.featured_collection.settings.product_limit.label",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:sections.featured_collection.settings.columns_desktop.label",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "t:sections.featured_collection.settings.columns_mobile.label",
      "default": 2
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.headers.card"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.featured_collection.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.featured_collection.settings.show_quick_add.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.headers.style"
    },
    {
      "type": "checkbox",
      "id": "style_dark_mode",
      "label": "t:sections.featured_collection.settings.style_dark_mode.label",
      "default": false
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:sections.featured_collection.settings.accent_color.label",
      "default": "#FF3B00"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.headers.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.featured_collection.settings.padding_top.label",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.featured_collection.settings.padding_bottom.label",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name",
      "settings": {
        "eyebrow": "Drop 03",
        "heading": "Latest Drop",
        "subheading": "Heavyweight basics built for the streets.",
        "layout": "grid",
        "product_limit": 8,
        "columns_desktop": 4,
        "columns_mobile": 2
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
