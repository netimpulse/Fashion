{%- liquid
  assign has_product = false
  if product != blank and product.title != blank
    assign has_product = true
    assign current_variant = product.selected_or_first_available_variant
  endif

  assign section_id = section.id
  assign style_dark = section.settings.style_dark_mode
  assign accent_color = section.settings.accent_color
  assign sticky_info = section.settings.enable_sticky_info
  assign show_zoom = section.settings.show_zoom
  assign show_badges = section.settings.show_badges
  assign low_stock_threshold = section.settings.low_stock_threshold
  assign new_badge_text = section.settings.new_badge_text
-%}

{{ 'section-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section_id }} {
    --product-pad-top: {{ section.settings.padding_top }}px;
    --product-pad-bottom: {{ section.settings.padding_bottom }}px;
    --product-accent: {{ accent_color.red }} {{ accent_color.green }} {{ accent_color.blue }};
  }
{% endstyle %}

<section
  class="product full-width{% if style_dark %} product--dark{% endif %}{% if sticky_info %} product--sticky-info{% endif %}"
  id="product-{{ section_id }}"
  data-section-id="{{ section_id }}"
  data-section-type="product"
>
  <product-form
    class="product__layout"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-section-id="{{ section_id }}"
  >
    <div class="product__media-col">
      {%- if has_product -%}
        {%- if show_badges -%}
          <div class="product__badges" aria-hidden="true">
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="product__badge product__badge--sale">{{ 'products.product.badges.sale' | t }}</span>
            {%- endif -%}
            {%- assign days_since_publish = 'now' | date: '%s' | minus: product.published_at | date: '%s' -%}
            {%- if days_since_publish < 2592000 and new_badge_text != blank -%}
              <span class="product__badge product__badge--new">{{ new_badge_text }}</span>
            {%- endif -%}
            {%- unless current_variant.available -%}
              <span class="product__badge product__badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
            {%- endunless -%}
          </div>
        {%- endif -%}

        {%- render 'product-media-gallery',
          product: product,
          section_id: section_id,
          enable_zoom: show_zoom
        -%}
      {%- else -%}
        <div class="product-gallery product-gallery--placeholder">
          <div class="product-gallery__stage">
            <div class="product-gallery__slide is-active">
              {{ 'product-1' | placeholder_svg_tag: 'product-gallery__image product-gallery__image--placeholder' }}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    <aside class="product__info-col" data-info-col>
      <div class="product__info-inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'vendor' -%}
              {%- if has_product and product.vendor != blank -%}
                <p class="product__vendor" {{ block.shopify_attributes }}>
                  <a href="{{ routes.search_url }}?q={{ product.vendor | url_encode }}">{{ product.vendor }}</a>
                </p>
              {%- elsif has_product == false -%}
                <p class="product__vendor" {{ block.shopify_attributes }}>BRAND</p>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>
                {%- if has_product -%}
                  {{ product.title }}
                {%- else -%}
                  {{ 'onboarding.product_title' | t }}
                {%- endif -%}
              </h1>

            {%- when 'sku' -%}
              {%- if has_product and current_variant.sku != blank -%}
                <p class="product__sku" {{ block.shopify_attributes }} data-sku-wrapper>
                  <span class="product__sku-label">{{ 'products.product.sku' | t }}</span>
                  <span data-sku>{{ current_variant.sku }}</span>
                </p>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product__price-block" {{ block.shopify_attributes }} data-price-block>
                {%- if has_product -%}
                  {%- render 'product-price', product: product, variant: current_variant -%}
                {%- else -%}
                  <div class="price">
                    <span class="price__current">{{ 4900 | money }}</span>
                  </div>
                {%- endif -%}
                {%- if has_product and current_variant.available and current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= low_stock_threshold -%}
                  <p class="product__low-stock" data-low-stock>
                    {{ 'products.product.low_stock_html' | t: count: current_variant.inventory_quantity }}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'short_description' -%}
              {%- if block.settings.text != blank -%}
                <div class="product__short-desc rte" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- if has_product and product.has_only_default_variant == false -%}
                <variant-picker
                  class="product__variant-picker"
                  {{ block.shopify_attributes }}
                  data-section-id="{{ section_id }}"
                  data-update-url="{{ block.settings.update_url }}"
                >
                  {%- for option in product.options_with_values -%}
                    {%- assign option_index = forloop.index0 -%}
                    {%- assign option_name_down = option.name | downcase -%}
                    {%- assign is_color = false -%}
                    {%- if option_name_down contains 'color' or option_name_down contains 'farbe' or option_name_down contains 'colour' -%}
                      {%- assign is_color = true -%}
                    {%- endif -%}

                    <fieldset class="variant-picker__group{% if is_color %} variant-picker__group--color{% endif %}">
                      <legend class="variant-picker__legend">
                        <span class="variant-picker__legend-label">{{ option.name }}</span>
                        <span class="variant-picker__legend-value" data-selected-value-for="{{ option.name | escape }}">{{ option.selected_value }}</span>
                      </legend>

                      <div class="variant-picker__options">
                        {%- for value in option.values -%}
                          {%- assign input_id = 'opt-' | append: section_id | append: '-' | append: option_index | append: '-' | append: forloop.index -%}
                          {%- assign is_selected = false -%}
                          {%- if option.selected_value == value -%}
                            {%- assign is_selected = true -%}
                          {%- endif -%}

                          <input
                            type="radio"
                            name="options[{{ option.name | escape }}]"
                            id="{{ input_id }}"
                            value="{{ value | escape }}"
                            class="variant-picker__input visually-hidden"
                            data-option-index="{{ option_index }}"
                            data-option-value="{{ value | escape }}"
                            data-option-name="{{ option.name | escape }}"
                            {% if is_selected %}checked{% endif %}
                          >
                          <label for="{{ input_id }}" class="variant-picker__option{% if is_color %} variant-picker__option--swatch{% endif %}"{% if is_color %} style="--swatch-color: {{ value | downcase | replace: ' ', '' }};"{% endif %}>
                            {%- if is_color -%}
                              <span class="visually-hidden">{{ value }}</span>
                            {%- else -%}
                              <span>{{ value }}</span>
                            {%- endif -%}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}

                  {%- if block.settings.show_size_chart_link -%}
                    <button type="button" class="variant-picker__size-chart" data-size-chart-trigger>
                      {{ 'products.product.size_chart' | t }}
                    </button>
                  {%- endif -%}

                  <script type="application/json" data-variants-json>
                    {{ product.variants | json }}
                  </script>
                </variant-picker>
              {%- endif -%}

            {%- when 'quantity' -%}
              <div class="product__quantity" {{ block.shopify_attributes }}>
                <label for="Quantity-{{ section_id }}" class="product__quantity-label">
                  {{ 'products.product.quantity' | t }}
                </label>
                <quantity-stepper class="quantity-stepper">
                  <button type="button" class="quantity-stepper__btn" data-quantity-decrease aria-label="{{ 'products.product.quantity_decrease' | t }}">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                      <path d="M5 12h14"></path>
                    </svg>
                  </button>
                  <input
                    type="number"
                    id="Quantity-{{ section_id }}"
                    class="quantity-stepper__input"
                    name="quantity"
                    value="1"
                    min="1"
                    step="1"
                    inputmode="numeric"
                    data-quantity-input
                    form="product-form-{{ section_id }}"
                  >
                  <button type="button" class="quantity-stepper__btn" data-quantity-increase aria-label="{{ 'products.product.quantity_increase' | t }}">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                      <path d="M12 5v14M5 12h14"></path>
                    </svg>
                  </button>
                </quantity-stepper>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }} data-buy-buttons>
                {%- if has_product -%}
                  {%- form 'product', product, id: 'product-form-' | append: section_id, class: 'product-form', novalidate: 'novalidate' -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

                    <button
                      type="submit"
                      name="add"
                      class="btn btn--primary btn--block product__atc"
                      data-atc-button
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      <span class="product__atc-text" data-atc-text>
                        {%- if current_variant.available -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                      <span class="product__atc-spinner" data-atc-spinner aria-hidden="true"></span>
                    </button>

                    {%- if block.settings.show_dynamic_checkout -%}
                      {{ form | payment_button }}
                    {%- endif -%}
                  {%- endform -%}
                {%- else -%}
                  <button type="button" class="btn btn--primary btn--block product__atc" disabled>
                    {{ 'products.product.add_to_cart' | t }}
                  </button>
                {%- endif -%}
              </div>

            {%- when 'trust_badges' -%}
              {%- if block.settings.badge_1_text != blank or block.settings.badge_2_text != blank or block.settings.badge_3_text != blank -%}
                <ul class="product__trust" {{ block.shopify_attributes }}>
                  {%- if block.settings.badge_1_text != blank -%}
                    <li class="product__trust-item">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                        <path d="M5 13l4 4L19 7"></path>
                      </svg>
                      <span>{{ block.settings.badge_1_text }}</span>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.badge_2_text != blank -%}
                    <li class="product__trust-item">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                        <path d="M3 7h13l5 5v5h-2"></path><circle cx="7" cy="17" r="2"></circle><circle cx="17" cy="17" r="2"></circle>
                      </svg>
                      <span>{{ block.settings.badge_2_text }}</span>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.badge_3_text != blank -%}
                    <li class="product__trust-item">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                        <path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"></path>
                      </svg>
                      <span>{{ block.settings.badge_3_text }}</span>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}

            {%- when 'collapsible_row' -%}
              {%- assign collapsible_open = block.settings.open_by_default -%}
              <details class="product__collapsible" {{ block.shopify_attributes }}{% if collapsible_open %} open{% endif %}>
                <summary class="product__collapsible-summary">
                  <span class="product__collapsible-heading">{{ block.settings.heading | default: 'Details' }}</span>
                  <span class="product__collapsible-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
                      <path d="M6 9l6 6 6-6"></path>
                    </svg>
                  </span>
                </summary>
                <div class="product__collapsible-content rte">
                  {{ block.settings.content }}
                </div>
              </details>

            {%- when 'description' -%}
              {%- if has_product and product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}

            {%- when 'share' -%}
              {%- if has_product -%}
                <div class="product__share" {{ block.shopify_attributes }}>
                  <span class="product__share-label">{{ 'products.product.share' | t }}</span>
                  <a class="product__share-link" target="_blank" rel="noopener" aria-label="{{ 'products.product.share_on_twitter' | t }}" href="https://twitter.com/intent/tweet?text={{ product.title | url_encode }}&url={{ shop.url | append: product.url | url_encode }}">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M22 5.8c-.7.3-1.5.6-2.4.7.9-.5 1.5-1.3 1.8-2.3-.8.5-1.7.8-2.7 1-.8-.8-1.9-1.4-3.1-1.4-2.4 0-4.3 1.9-4.3 4.3 0 .3 0 .7.1 1C7.7 8.9 4.6 7.2 2.4 4.6c-.4.6-.6 1.3-.6 2.1 0 1.5.8 2.8 1.9 3.6-.7 0-1.4-.2-2-.5v.1c0 2.1 1.5 3.8 3.4 4.2-.4.1-.7.2-1.1.2-.3 0-.5 0-.8-.1.5 1.7 2.1 2.9 4 3-1.5 1.1-3.3 1.8-5.2 1.8h-1c1.9 1.2 4.1 1.9 6.5 1.9 7.8 0 12-6.4 12-12v-.5c.8-.6 1.5-1.3 2-2.2z"/></svg>
                  </a>
                  <a class="product__share-link" target="_blank" rel="noopener" aria-label="{{ 'products.product.share_on_facebook' | t }}" href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_encode }}">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M22 12c0-5.5-4.5-10-10-10S2 6.5 2 12c0 5 3.7 9.1 8.4 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7C18.3 21.1 22 17 22 12z"/></svg>
                  </a>
                  <button type="button" class="product__share-link" data-share-copy aria-label="{{ 'products.product.share_copy' | t }}">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
                  </button>
                </div>
              {%- endif -%}

            {%- when 'custom_text' -%}
              {%- if block.settings.text != blank -%}
                <div class="product__custom-text rte" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

            {%- when '@app' -%}
              <div class="product__app-block" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </aside>
  </product-form>
</section>

{% schema %}
{
  "name": "t:general.product",
  "tag": "section",
  "class": "section-product",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.product.headers.style"
    },
    {
      "type": "checkbox",
      "id": "style_dark_mode",
      "label": "t:sections.product.settings.style_dark_mode.label",
      "default": false
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:sections.product.settings.accent_color.label",
      "default": "#FF3B00"
    },
    {
      "type": "header",
      "content": "t:sections.product.headers.media"
    },
    {
      "type": "checkbox",
      "id": "show_zoom",
      "label": "t:sections.product.settings.show_zoom.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.product.headers.layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "t:sections.product.settings.enable_sticky_info.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.product.headers.badges"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "t:sections.product.settings.show_badges.label",
      "default": true
    },
    {
      "type": "text",
      "id": "new_badge_text",
      "label": "t:sections.product.settings.new_badge_text.label",
      "default": "NEW DROP"
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "min": 0,
      "max": 20,
      "step": 1,
      "label": "t:sections.product.settings.low_stock_threshold.label",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:sections.product.headers.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.product.settings.padding_top.label",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.product.settings.padding_bottom.label",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "t:sections.product.blocks.vendor.name",
      "limit": 1
    },
    {
      "type": "title",
      "name": "t:sections.product.blocks.title.name",
      "limit": 1
    },
    {
      "type": "sku",
      "name": "t:sections.product.blocks.sku.name",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:sections.product.blocks.price.name",
      "limit": 1
    },
    {
      "type": "short_description",
      "name": "t:sections.product.blocks.short_description.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.product.blocks.short_description.settings.text.label",
          "default": "<p>Your short product intro. Make it punchy.</p>"
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "t:sections.product.blocks.variant_picker.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "update_url",
          "label": "t:sections.product.blocks.variant_picker.settings.update_url.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_size_chart_link",
          "label": "t:sections.product.blocks.variant_picker.settings.show_size_chart.label",
          "default": false
        }
      ]
    },
    {
      "type": "quantity",
      "name": "t:sections.product.blocks.quantity.name",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "t:sections.product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "default": true
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "t:sections.product.blocks.trust_badges.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "badge_1_text",
          "label": "t:sections.product.blocks.trust_badges.settings.badge_1.label",
          "default": "Free shipping over 100"
        },
        {
          "type": "text",
          "id": "badge_2_text",
          "label": "t:sections.product.blocks.trust_badges.settings.badge_2.label",
          "default": "Easy 30-day returns"
        },
        {
          "type": "text",
          "id": "badge_3_text",
          "label": "t:sections.product.blocks.trust_badges.settings.badge_3.label",
          "default": "Secure checkout"
        }
      ]
    },
    {
      "type": "collapsible_row",
      "name": "t:sections.product.blocks.collapsible_row.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.product.blocks.collapsible_row.settings.heading.label",
          "default": "t:sections.product.blocks.collapsible_row.settings.heading.default"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.product.blocks.collapsible_row.settings.content.label",
          "default": "<p>Add your collapsible content here.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "t:sections.product.blocks.collapsible_row.settings.open_by_default.label",
          "default": false
        }
      ]
    },
    {
      "type": "description",
      "name": "t:sections.product.blocks.description.name",
      "limit": 1
    },
    {
      "type": "share",
      "name": "t:sections.product.blocks.share.name",
      "limit": 1
    },
    {
      "type": "custom_text",
      "name": "t:sections.product.blocks.custom_text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.product.blocks.custom_text.settings.text.label",
          "default": "<p>Custom text content.</p>"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:general.product",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "price" },
        { "type": "short_description" },
        { "type": "variant_picker" },
        { "type": "quantity" },
        { "type": "buy_buttons" },
        { "type": "trust_badges" },
        {
          "type": "collapsible_row",
          "settings": {
            "heading": "t:sections.product.blocks.collapsible_row.presets.material.heading",
            "content": "t:sections.product.blocks.collapsible_row.presets.material.content"
          }
        },
        {
          "type": "collapsible_row",
          "settings": {
            "heading": "t:sections.product.blocks.collapsible_row.presets.shipping.heading",
            "content": "t:sections.product.blocks.collapsible_row.presets.shipping.content"
          }
        },
        { "type": "description" },
        { "type": "share" }
      ]
    }
  ],
