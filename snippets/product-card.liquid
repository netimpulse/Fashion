{% doc %}
  Renders a minimal product card (image, title, price) linking to the product.

  @param {object} product - The product object to render. Required.
  @param {boolean} [show_price] - Whether to show the price. Default true.
  @param {string} [sizes] - The image `sizes` attribute. Default '320px'.

  @example
  {% render 'product-card', product: product, show_price: true %}
{% enddoc %}

{%- liquid
  assign show_price = show_price | default: true, allow_false: true
  assign card_sizes = sizes | default: '320px'
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign img_alt = product.featured_image.alt | default: product.title | escape
-%}

<a class="product-card" href="{{ product.url | default: routes.root_url }}">
  <div class="product-card__media">
    {%- if product.featured_image != blank -%}
      {{
        product.featured_image
        | image_url: width: 700
        | image_tag:
          loading: 'lazy',
          sizes: card_sizes,
          widths: '180, 280, 360, 540, 700',
          alt: img_alt,
          class: 'product-card__img'
      }}
    {%- else -%}
      <div class="product-card__img product-card__img--empty" role="img" aria-label="{{ 'landing.image_placeholder' | t }}"></div>
    {%- endif -%}
    {%- if on_sale -%}
      <span class="product-card__badge">{{ 'landing.sale' | t }}</span>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    <span class="product-card__title">{{ product.title }}</span>
    {%- if show_price -%}
      <span class="product-card__price">
        {%- if on_sale -%}
          <s class="product-card__was">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
        <span class="product-card__now">{{ product.price | money }}</span>
      </span>
    {%- endif -%}
  </div>
</a>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
  }

  .product-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background-color: color-mix(in srgb, currentcolor 5%, transparent);
  }

  .product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-card__img--empty {
    background: repeating-linear-gradient(
      135deg,
      color-mix(in srgb, currentcolor 6%, transparent),
      color-mix(in srgb, currentcolor 6%, transparent) 12px,
      color-mix(in srgb, currentcolor 10%, transparent) 12px,
      color-mix(in srgb, currentcolor 10%, transparent) 24px
    );
  }

  .product-card:hover .product-card__img {
    transform: scale(1.05);
  }

  .product-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.3em 0.75em;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background-color: var(--color-foreground, #14110f);
    color: var(--color-background, #ffffff);
  }

  .product-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .product-card__title {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .product-card__price {
    display: inline-flex;
    gap: 0.5em;
    font-size: 0.9rem;
    color: color-mix(in srgb, currentcolor 75%, transparent);
  }

  .product-card__was {
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__img {
      transition: none;
    }
  }
{% endstylesheet %}
