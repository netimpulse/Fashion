{% comment %}
  Password / "coming soon" landing page shown when the storefront is locked.

  Beyond the required password entry it shows a small endless-runner mini game
  (assets/password-game.js) and an email sign-up so visitors can register for the
  drop. The leaderboard + automatic winner discounts are planned but require an
  external backend — see CLAUDE.md → "Passwortseiten-Spiel".

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{{ 'password-game.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    --game-accent: {{ section.settings.accent_color | default: '#111111' }};
  }
  #shopify-section-{{ section.id }} .pwd-game {
    --pwd-padding-top: {{ section.settings.padding_top }}px;
    --pwd-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="pwd-game">
  <div class="pwd-game__inner">
    <header class="pwd-game__hero">
      {% if section.settings.heading != blank %}
        <h1 class="pwd-game__title">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <div class="pwd-game__subtitle">{{ section.settings.subheading }}</div>
      {% endif %}
    </header>

    {% if section.settings.show_game %}
      <password-game
        class="pwd-game__game"
        role="group"
        aria-label="{{ section.settings.heading | default: shop.name | escape }}"
        data-player="{{ section.settings.game_player | escape }}"
        data-obstacles="{{ section.settings.game_obstacles | escape }}"
        data-storage-key="fashion-runner-{{ shop.permanent_domain | handle }}"
      >
        <div class="pwd-game__hud">
          <span class="pwd-game__score">{{ 'general.score' | t }}<b data-game-score>0</b></span>
          <span class="pwd-game__best">{{ 'general.best' | t }}<b data-game-best>0</b></span>
        </div>

        <div class="pwd-game__stage">
          <canvas class="pwd-game__canvas" data-game-canvas aria-label="Mini game" role="img"></canvas>
          <div
            class="pwd-game__overlay"
            data-game-overlay
            data-idle-title="Ready?"
            data-idle-text="Tap or press space to jump"
            data-idle-btn="Play"
            data-over-title="Game over"
            data-best-title="New high score!"
            data-over-text="Score: %score%"
            data-over-btn="Play again"
          >
            <p class="pwd-game__overlay-title" data-game-overlay-title>Ready?</p>
            <p class="pwd-game__overlay-text" data-game-overlay-text>Tap or press space to jump</p>
            <button type="button" class="pwd-game__btn" data-game-start>Play</button>
          </div>
        </div>

        {% if section.settings.game_hint != blank %}
          <p class="pwd-game__hint">{{ section.settings.game_hint }}</p>
        {% endif %}
      </password-game>
    {% endif %}

    {% if section.settings.leaderboard_note != blank %}
      <p class="pwd-game__note">{{ section.settings.leaderboard_note }}</p>
    {% endif %}

    {% if section.settings.show_signup %}
      <div class="pwd-game__signup">
        {% if section.settings.signup_heading != blank %}
          <h2 class="pwd-game__signup-title">{{ section.settings.signup_heading }}</h2>
        {% endif %}
        {% if section.settings.signup_text != blank %}
          <div class="pwd-game__signup-text">{{ section.settings.signup_text }}</div>
        {% endif %}

        {% form 'customer', class: 'pwd-game__form' %}
          {% if form.posted_successfully? %}
            <p class="pwd-game__success" role="status">{{ section.settings.success_text }}</p>
          {% else %}
            {% if form.errors %}
              <p class="pwd-game__error" role="alert">{{ form.errors | default_errors }}</p>
            {% endif %}
            <input type="hidden" name="contact[tags]" value="newsletter, fashion-game">
            <label class="pwd-game__label" for="PwdEmail-{{ section.id }}">
              {{ section.settings.email_placeholder | default: 'Email' }}
            </label>
            <div class="pwd-game__field">
              <input
                id="PwdEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.email_placeholder | escape }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
              >
              <button type="submit" class="pwd-game__btn">
                {{ section.settings.signup_cta | default: 'Notify me' }}
              </button>
            </div>
            {% if section.settings.consent_text != blank %}
              <label class="pwd-game__consent">
                <input type="checkbox" required>
                <span>{{ section.settings.consent_text }}</span>
              </label>
            {% endif %}
          {% endif %}
        {% endform %}
      </div>
    {% endif %}

    <details class="pwd-game__staff">
      <summary>{{ 'password.title' | t }}</summary>
      {% form 'storefront_password' %}
        {% if form.errors %}
          <p class="pwd-game__error" role="alert">{{ form.errors | default_errors }}</p>
        {% endif %}
        <label class="pwd-game__label" for="Password-{{ section.id }}">{{ 'password.password' | t }}</label>
        <input
          type="password"
          name="password"
          id="Password-{{ section.id }}"
          placeholder="{{ 'password.password' | t | escape }}"
          autocomplete="current-password"
        >
        <button type="submit" class="pwd-game__btn">{{ 'password.enter' | t }}</button>
      {% endform %}
    </details>
  </div>
</section>

{% if section.settings.show_game %}
  <script src="{{ 'password-game.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    { "type": "header", "content": "t:general.content" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The next drop is loading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "<p>Beat the clock while you wait. Sign up to play for early access and a launch-day discount.</p>"
    },
    { "type": "header", "content": "t:labels.game" },
    {
      "type": "checkbox",
      "id": "show_game",
      "label": "t:labels.show_game",
      "default": true
    },
    {
      "type": "text",
      "id": "game_player",
      "label": "t:labels.game_player",
      "default": "🛍️",
      "info": "t:labels.game_player_info"
    },
    {
      "type": "text",
      "id": "game_obstacles",
      "label": "t:labels.game_obstacles",
      "default": "👗,👠,🧥,👜,🕶️"
    },
    {
      "type": "text",
      "id": "game_hint",
      "label": "t:labels.instructions",
      "default": "Press space, ↑ or tap to jump."
    },
    {
      "type": "text",
      "id": "leaderboard_note",
      "label": "t:labels.leaderboard",
      "default": "Leaderboard & prizes arrive with the collection — the top players win a discount."
    },
    { "type": "header", "content": "t:labels.email_capture" },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "t:labels.show_signup",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "t:labels.signup_heading",
      "default": "Get on the list"
    },
    {
      "type": "richtext",
      "id": "signup_text",
      "label": "t:labels.signup_text",
      "default": "<p>Be first to shop the drop and enter the discount contest.</p>"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "t:labels.email_placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "signup_cta",
      "label": "t:labels.signup_cta",
      "default": "Notify me"
    },
    {
      "type": "inline_richtext",
      "id": "consent_text",
      "label": "t:labels.consent_text",
      "default": "I agree to receive marketing emails and accept the contest terms."
    },
    {
      "type": "inline_richtext",
      "id": "success_text",
      "label": "t:labels.success_text",
      "default": "You're in! Watch your inbox for the drop."
    },
    { "type": "header", "content": "t:general.colors" },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:labels.accent_color",
      "default": "#111111"
    },
    { "type": "header", "content": "t:labels.padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding_bottom",
      "default": 48
    }
  ]
}
{% endschema %}
