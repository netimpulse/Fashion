{% comment %}
  Landing page section: one-click complete homepage — hero, marquee,
  featured products, collections, story, drop countdown, newsletter.
  Built from theme blocks, fully rearrangeable.
{% endcomment %}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .landing-page {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div class="landing-page section-pad color-scheme color-{{ scheme.id }}">
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:sections.landing.name",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.landing.name",
      "blocks": [
        { "type": "hero" },
        { "type": "marquee" },
        { "type": "featured-collection" },
        { "type": "collection-list" },
        {
          "type": "image-with-text",
          "settings": {
            "layout": "right"
          }
        },
        { "type": "countdown" },
        { "type": "quote" },
        { "type": "newsletter" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
