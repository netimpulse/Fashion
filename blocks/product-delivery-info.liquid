{% doc %}
  Delivery info block.

  Three layers of data:
  1. Live countdown to a daily order-cutoff time (browser-side JS).
  2. Estimated delivery date range (calculated client-side from min/max
     business days; automatically pushes by 1 day after the cutoff has passed
     and skips weekends if enabled).
  3. All values can be overridden per product via metafields:
       custom.delivery_min_days  (Integer)
       custom.delivery_max_days  (Integer)
       custom.delivery_text      (Single-line text — completely replaces
                                  the "Lieferung bis X – Y" line, useful for
                                  pre-orders or made-to-order items)
     Namespace and keys are configurable in the block settings.

  @example
  {% content_for 'block', type: 'product-delivery-info', id: 'delivery' %}
{% enddoc %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign in_stock = false
  if current_variant.available
    assign in_stock = true
  endif

  assign mf_ns = block.settings.metafield_namespace | default: 'custom'

  assign min_days = block.settings.min_days
  if block.settings.metafield_min_days != blank
    assign mf_min = product.metafields[mf_ns][block.settings.metafield_min_days].value
    if mf_min != blank
      assign min_days = mf_min | times: 1
    endif
  endif

  assign max_days = block.settings.max_days
  if block.settings.metafield_max_days != blank
    assign mf_max = product.metafields[mf_ns][block.settings.metafield_max_days].value
    if mf_max != blank
      assign max_days = mf_max | times: 1
    endif
  endif

  assign override_text = ''
  if block.settings.metafield_text != blank
    assign override_text = product.metafields[mf_ns][block.settings.metafield_text].value
  endif
-%}

<delivery-estimate
  class="pdp-delivery"
  data-min-days="{{ min_days }}"
  data-max-days="{{ max_days }}"
  {% if block.settings.show_cutoff and block.settings.cutoff_time != blank %}
    data-cutoff-time="{{ block.settings.cutoff_time }}"
    data-cutoff-tz="{{ block.settings.cutoff_timezone }}"
    data-cutoff-text-before="{{ block.settings.cutoff_text_before | escape }}"
    data-cutoff-text-after="{{ block.settings.cutoff_text_after | escape }}"
    data-cutoff-skip-weekend="{{ block.settings.cutoff_skip_weekend }}"
    data-cutoff-time-format="{{ block.settings.cutoff_time_format | escape }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.show_stock -%}
    <div class="pdp-delivery__row">
      <span class="pdp-delivery__dot" style="background: {% if in_stock %}{{ block.settings.in_stock_color }}{% else %}#c33{% endif %};"></span>
      <span>
        {%- if in_stock -%}
          <span class="pdp-delivery__strong">{{ block.settings.in_stock_text }}</span>
        {%- else -%}
          <span class="pdp-delivery__strong">{{ block.settings.out_of_stock_text }}</span>
        {%- endif -%}
      </span>
    </div>
  {%- endif -%}

  {%- if override_text != blank -%}
    <div class="pdp-delivery__row">
      <span class="pdp-delivery__strong">{{ override_text }}</span>
    </div>
  {%- elsif block.settings.show_delivery_date and in_stock -%}
    <div class="pdp-delivery__row">
      <span>{{ block.settings.delivery_prefix }}</span>
      <span class="pdp-delivery__strong" data-delivery-date>—</span>
    </div>
  {%- endif -%}

  {%- if block.settings.show_cutoff and block.settings.cutoff_time != blank -%}
    <div class="pdp-delivery__row pdp-delivery__row--cutoff" data-cutoff-row hidden>
      <span data-cutoff-text></span>
    </div>
  {%- endif -%}
</delivery-estimate>

{% schema %}
{
  "name": "t:blocks.delivery_info.name",
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.delivery_info.headers.stock"
    },
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "t:blocks.delivery_info.settings.show_stock",
      "default": true
    },
    {
      "type": "text",
      "id": "in_stock_text",
      "label": "t:blocks.delivery_info.settings.in_stock_text",
      "default": "Auf Lager"
    },
    {
      "type": "text",
      "id": "out_of_stock_text",
      "label": "t:blocks.delivery_info.settings.out_of_stock_text",
      "default": "Ausverkauft"
    },
    {
      "type": "color",
      "id": "in_stock_color",
      "label": "t:blocks.delivery_info.settings.in_stock_color",
      "default": "#2a9d4d"
    },
    {
      "type": "header",
      "content": "t:blocks.delivery_info.headers.delivery"
    },
    {
      "type": "checkbox",
      "id": "show_delivery_date",
      "label": "t:blocks.delivery_info.settings.show_delivery_date",
      "default": true
    },
    {
      "type": "text",
      "id": "delivery_prefix",
      "label": "t:blocks.delivery_info.settings.delivery_prefix",
      "default": "Lieferung bis"
    },
    {
      "type": "range",
      "id": "min_days",
      "min": 1,
      "max": 30,
      "step": 1,
      "label": "t:blocks.delivery_info.settings.min_days",
      "default": 2
    },
    {
      "type": "range",
      "id": "max_days",
      "min": 1,
      "max": 30,
      "step": 1,
      "label": "t:blocks.delivery_info.settings.max_days",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:blocks.delivery_info.headers.metafields"
    },
    {
      "type": "paragraph",
      "content": "t:blocks.delivery_info.settings.metafields_info"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "t:blocks.delivery_info.settings.metafield_namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_min_days",
      "label": "t:blocks.delivery_info.settings.metafield_min_days",
      "default": "delivery_min_days"
    },
    {
      "type": "text",
      "id": "metafield_max_days",
      "label": "t:blocks.delivery_info.settings.metafield_max_days",
      "default": "delivery_max_days"
    },
    {
      "type": "text",
      "id": "metafield_text",
      "label": "t:blocks.delivery_info.settings.metafield_text",
      "default": "delivery_text",
      "info": "t:blocks.delivery_info.settings.metafield_text_info"
    },
    {
      "type": "header",
      "content": "t:blocks.delivery_info.headers.cutoff"
    },
    {
      "type": "paragraph",
      "content": "t:blocks.delivery_info.settings.cutoff_info"
    },
    {
      "type": "checkbox",
      "id": "show_cutoff",
      "label": "t:blocks.delivery_info.settings.show_cutoff",
      "default": true
    },
    {
      "type": "text",
      "id": "cutoff_time",
      "label": "t:blocks.delivery_info.settings.cutoff_time",
      "default": "16:00",
      "info": "t:blocks.delivery_info.settings.cutoff_time_info"
    },
    {
      "type": "text",
      "id": "cutoff_timezone",
      "label": "t:blocks.delivery_info.settings.cutoff_timezone",
      "default": "Europe/Berlin",
      "info": "t:blocks.delivery_info.settings.cutoff_timezone_info"
    },
    {
      "type": "checkbox",
      "id": "cutoff_skip_weekend",
      "label": "t:blocks.delivery_info.settings.cutoff_skip_weekend",
      "default": true
    },
    {
      "type": "text",
      "id": "cutoff_text_before",
      "label": "t:blocks.delivery_info.settings.cutoff_text_before",
      "default": "Bestelle in den nächsten {time} für Versand heute",
      "info": "t:blocks.delivery_info.settings.cutoff_text_before_info"
    },
    {
      "type": "text",
      "id": "cutoff_time_format",
      "label": "t:blocks.delivery_info.settings.cutoff_time_format",
      "default": "{h} Std. {m} Min.",
      "info": "t:blocks.delivery_info.settings.cutoff_time_format_info"
    },
    {
      "type": "text",
      "id": "cutoff_text_after",
      "label": "t:blocks.delivery_info.settings.cutoff_text_after",
      "default": "Heute bestellt — morgen versendet",
      "info": "t:blocks.delivery_info.settings.cutoff_text_after_info"
    }
  ],
  "presets": [
    { "name": "t:blocks.delivery_info.name" }
  ]
}
{% endschema %}
