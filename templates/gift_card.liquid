{% layout none %}

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <title>{{ 'gift_card.card' | t }} &ndash; {{ shop.name }}</title>

    {% render 'meta-tags' %}

    {% render 'css-variables' %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% style %}
      .gift-card {
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--page-margin);
      }
      .gift-card__panel {
        width: min(26rem, 100%);
        border: 1px solid var(--color-foreground);
        padding: clamp(1.5rem, 5vw, 2.5rem);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        text-align: center;
      }
      .gift-card__balance {
        margin: 0;
        font-size: clamp(2.6rem, 9vw, 4rem);
      }
      .gift-card__brand {
        margin: 0;
        font-size: 1.1rem;
      }
      .gift-card__code {
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.18em;
        font-size: 1.05rem;
        font-weight: 700;
        border: 1px dashed rgba(var(--color-foreground-rgb), 0.5);
        padding: 0.7rem 1.2rem;
        user-select: all;
      }
      .gift-card__note {
        opacity: 0.7;
        font-size: 0.85rem;
        margin: 0;
      }
      .gift-card__expired {
        color: var(--badge-sale-bg);
        font-weight: 700;
        margin: 0;
      }
      .gift-card__wallet img {
        margin-inline: auto;
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <main id="MainContent" class="gift-card" role="main">
      <div class="gift-card__panel">
        <p class="eyebrow">{{ 'gift_card.card' | t }}</p>

        {% if settings.logo %}
          {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
          {{ settings.logo | image_url: width: 240 | image_tag: alt: logo_alt, width: 120 }}
        {% else %}
          <h2 class="gift-card__brand h3">{{ shop.name }}</h2>
        {% endif %}

        <h1 class="gift-card__balance">{{ gift_card.balance | money }}</h1>

        {% if gift_card.enabled == false or gift_card.expired %}
          <p class="gift-card__expired">{{ 'gift_card.expired' | t }}</p>
        {% endif %}

        {% if gift_card.expires_on %}
          {% assign expires_on = gift_card.expires_on | date: format: 'abbreviated_date' %}
          <p class="gift-card__note">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
        {% endif %}

        <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
        <p class="gift-card__note">{{ 'gift_card.use_at_checkout' | t }}</p>

        {% if gift_card.pass_url %}
          <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              width="200"
              height="60"
              loading="lazy"
            >
          </a>
        {% endif %}

        <a href="{{ shop.url }}" class="btn btn--full">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    </main>
  </body>
</html>
