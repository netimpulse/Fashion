{% comment %}
  Standard page (About, Legal, AGB, …): title + prose content, optional
  narrow reading width — used by page, page.legal, page.size-guide templates.
{% endcomment %}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .main-page {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="main-page section-pad color-scheme color-{{ scheme.id }}">
  <div class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %}">
    {%- if section.settings.show_title -%}
      <header class="main-page__header" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="main-page__title">{{ page.title | escape }}</h1>
      </header>
    {%- endif -%}

    <div class="main-page__content rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% stylesheet %}
  .main-page__header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-block-end: 2rem;
    padding-block-end: 1.25rem;
    border-bottom: 1px solid var(--color-foreground);
  }

  .main-page__title {
    margin: 0;
  }

  .main-page__content {
    max-width: 75ch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:sections.page.show_title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "t:sections.page.narrow",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
