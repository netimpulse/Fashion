{% doc %}
  Bento / mosaic grid of collection tiles in mixed sizes. Add "Bento tile"
  child blocks and pick a size per tile.

  @example
  {% content_for 'block', type: 'bento-grid', id: 'bento-grid' %}
{% enddoc %}

<div
  class="bento"
  style="--bento-bg: {{ block.settings.color_background }}; --bento-fg: {{ block.settings.color_text }}; --bento-gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  <div class="bento__inner">
    {%- if block.settings.eyebrow != blank or block.settings.heading != blank -%}
      <header class="bento__head">
        {%- if block.settings.eyebrow != blank -%}
          <p class="bento__eyebrow">{{ block.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 class="bento__heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="bento__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .bento {
    width: 100%;
    background-color: var(--bento-bg, #ffffff);
    color: var(--bento-fg, #14110f);
  }

  .bento__inner {
    width: 100%;
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 5rem) var(--page-margin, 20px);
  }

  .bento__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .bento__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--bento-fg, #14110f) 60%, transparent);
  }

  .bento__heading {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .bento__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 160px;
    gap: var(--bento-gap, 16px);
  }

  /* Shopify wraps each theme block in a .shopify-block element, so the grid
     items are the wrappers — span the wrapper based on the tile's modifier.
     The bare .bento-tile rules are a fallback if no wrapper is present. */
  .bento__grid > .shopify-block {
    min-width: 0;
  }

  .bento__grid > .shopify-block:has(.bento-tile--wide),
  .bento-tile--wide {
    grid-column: span 2;
  }

  .bento__grid > .shopify-block:has(.bento-tile--tall),
  .bento-tile--tall {
    grid-row: span 2;
  }

  .bento__grid > .shopify-block:has(.bento-tile--large),
  .bento-tile--large {
    grid-column: span 2;
    grid-row: span 2;
  }

  @media screen and (min-width: 750px) {
    .bento__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 220px;
      grid-auto-flow: dense;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.bento_grid.name",
  "blocks": [{ "type": "bento-tile" }],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Find your edit"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:labels.background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:labels.foreground",
      "default": "#14110F"
    }
  ],
  "presets": [{ "name": "t:blocks.bento_grid.name" }]
}
{% endschema %}
