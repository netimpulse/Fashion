{% doc %}
  A single tile inside the bento grid. Links to a collection (image + title
  pulled automatically) or to a custom destination. Pick a size to control
  how much of the mosaic it occupies.

  @example
  {% content_for 'block', type: 'bento-tile', id: 'bento-tile' %}
{% enddoc %}

{%- liquid
  assign collection = block.settings.collection
  assign has_collection = false
  if collection != blank and collection.title != blank
    assign has_collection = true
  endif

  if block.settings.image != blank
    assign tile_image = block.settings.image
  elsif has_collection
    assign tile_image = collection.featured_image
    if tile_image == blank
      assign tile_image = collection.products.first.featured_image
    endif
  endif

  if block.settings.title != blank
    assign tile_title = block.settings.title
  elsif has_collection
    assign tile_title = collection.title
  endif

  if block.settings.link != blank
    assign tile_url = block.settings.link
  elsif has_collection
    assign tile_url = collection.url
  else
    assign tile_url = routes.all_products_collection_url
  endif

  assign tile_alt = tile_image.alt | default: tile_title | escape
-%}

<a
  class="bento-tile bento-tile--{{ block.settings.size }}"
  href="{{ tile_url }}"
  {{ block.shopify_attributes }}
>
  <div class="bento-tile__media">
    {%- if tile_image != blank -%}
      {{
        tile_image
        | image_url: width: 1400
        | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 900, 1200, 1400', alt: tile_alt, class: 'bento-tile__img'
      }}
    {%- else -%}
      <div class="bento-tile__img bento-tile__img--empty"></div>
    {%- endif -%}
  </div>

  <div class="bento-tile__overlay">
    {%- if block.settings.kicker != blank -%}
      <span class="bento-tile__kicker">{{ block.settings.kicker }}</span>
    {%- endif -%}
    <span class="bento-tile__title">{{ tile_title | default: 'Collection' }}</span>
    <span class="bento-tile__cta">{{ 'landing.discover' | t }} &rarr;</span>
  </div>
</a>

{% stylesheet %}
  .bento-tile {
    position: relative;
    display: block;
    overflow: hidden;
    width: 100%;
    height: 100%;
    min-height: 160px;
    min-width: 0;
    text-decoration: none;
    color: #ffffff;
    background-color: color-mix(in srgb, currentcolor 8%, transparent);
  }

  .bento-tile__media {
    position: absolute;
    inset: 0;
  }

  .bento-tile__img,
  .bento-tile__img--empty {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-tile__img--empty {
    background: repeating-linear-gradient(
      135deg,
      #2a2520,
      #2a2520 16px,
      #332d27 16px,
      #332d27 32px
    );
  }

  .bento-tile:hover .bento-tile__img {
    transform: scale(1.06);
  }

  .bento-tile__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.25rem;
    padding: clamp(1rem, 2vw, 1.75rem);
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.1) 45%,
      rgba(0, 0, 0, 0) 75%
    );
  }

  .bento-tile__kicker {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .bento-tile__title {
    font-size: clamp(1.1rem, 1.8vw, 1.6rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .bento-tile__cta {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-tile:hover .bento-tile__cta,
  .bento-tile:focus-visible .bento-tile__cta {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-tile__img,
    .bento-tile__cta {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.bento_tile.name",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:general.collection"
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:labels.tile_size",
      "default": "small",
      "options": [
        { "value": "small", "label": "t:options.tile_size.small" },
        { "value": "wide", "label": "t:options.tile_size.wide" },
        { "value": "tall", "label": "t:options.tile_size.tall" },
        { "value": "large", "label": "t:options.tile_size.large" }
      ]
    },
    {
      "type": "header",
      "content": "t:labels.overrides"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:labels.kicker"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ]
}
{% endschema %}
