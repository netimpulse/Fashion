{% comment %}
  Search page: big search field, product results as cards, pages/articles as
  list rows, pagination, empty state.
{% endcomment %}

{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .search-page {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
    --grid-cols-desktop: {{ section.settings.columns }};
    --grid-cols-tablet: {{ section.settings.columns | at_most: 3 }};
    --grid-gap: 1rem;
  }
{% endstyle %}

<section class="search-page section-pad color-scheme color-{{ scheme.id }}">
  <div class="page-width">
    <header class="search-page__header" data-reveal>
      <p class="eyebrow">{{ 'search.label' | t }}</p>
      <h1 class="search-page__title">{{ 'search.title' | t }}</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <label for="SearchInput-{{ section.id }}" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
        <input
          type="search"
          id="SearchInput-{{ section.id }}"
          class="search-page__input"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
        >
        <button type="submit" class="btn search-page__submit">
          {% render 'icon', icon: 'search' %}
          <span class="visually-hidden">{{ 'search.submit' | t }}</span>
        </button>
      </form>
    </header>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="search-page__empty">
          <p class="h3">{{ 'search.no_results' | t: terms: search.terms }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn">
            {{ 'collections.view_all' | t }}
          </a>
        </div>
      {%- else -%}
        <p class="search-page__count" role="status">
          {{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}
        </p>

        {%- paginate search.results by 24 -%}
          {%- liquid
            assign has_products = false
            assign has_other = false
            for result in search.results
              if result.object_type == 'product'
                assign has_products = true
              else
                assign has_other = true
              endif
            endfor
          -%}

          {%- if has_products -%}
            <ul class="product-grid search-page__products" role="list">
              {%- for result in search.results -%}
                {%- if result.object_type == 'product' -%}
                  <li>
                    {% render 'product-card', card_product: result %}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if has_other -%}
            <ul class="search-page__list" role="list">
              {%- for result in search.results -%}
                {%- unless result.object_type == 'product' -%}
                  <li class="search-page__row">
                    <a href="{{ result.url }}" class="search-page__row-link">
                      <span class="search-page__row-type eyebrow">
                        {%- if result.object_type == 'article' -%}
                          {{ 'search.types.article' | t }}
                        {%- else -%}
                          {{ 'search.types.page' | t }}
                        {%- endif -%}
                      </span>
                      <span class="search-page__row-title">{{ result.title | escape }}</span>
                      {% render 'icon', icon: 'arrow-up-right' %}
                    </a>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .search-page__header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-block-end: 2rem;
    max-width: 44rem;
  }

  .search-page__title {
    margin: 0;
  }

  .search-page__form {
    display: flex;
    gap: 0;
    margin-block-start: 0.75rem;
  }

  .search-page__input {
    border-right: 0;
    font-size: 1.05rem;
    min-height: 3.25rem;
  }

  .search-page__submit {
    min-height: 3.25rem;
  }

  .search-page__count {
    font-size: 0.85rem;
    opacity: 0.7;
    margin-block-end: 1.25rem;
  }

  .search-page__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    padding-block: 3rem;
  }

  .search-page__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .search-page__row {
    border-bottom: 1px solid rgba(var(--color-foreground-rgb), 0.15);
  }

  .search-page__row:first-child {
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.15);
  }

  .search-page__row-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1rem;
    text-decoration: none;
  }

  .search-page__row-link:hover .search-page__row-title {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .search-page__row-type {
    flex: none;
    min-width: 5.5rem;
  }

  .search-page__row-title {
    font-size: 1rem;
  }

  .search-page__row-link .icon--arrow-up-right {
    margin-inline-start: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
