{% doc %}
  Single trust badge — used as child block inside `product-trust-badges`.

  @example
  {% content_for 'block', type: 'trust-badge', id: 'badge-1' %}
{% enddoc %}

<div class="pdp-trust__item" {{ block.shopify_attributes }}>
  <span class="pdp-trust__icon" aria-hidden="true">
    {%- case block.settings.icon -%}
      {%- when 'return' -%}
        <svg viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
      {%- when 'lock' -%}
        <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {%- when 'truck' -%}
        <svg viewBox="0 0 24 24"><rect x="1" y="6" width="14" height="11" rx="1"/><path d="M15 9h4l3 4v4h-7"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg>
      {%- when 'leaf' -%}
        <svg viewBox="0 0 24 24"><path d="M21 3c-9 0-15 6-15 12 0 3 3 6 6 6 6 0 12-6 12-15 0-1-1-3-3-3z"/><path d="M6 21L21 6"/></svg>
      {%- when 'star' -%}
        <svg viewBox="0 0 24 24"><polygon points="12 2 15 9 22 9 17 14 19 21 12 17 5 21 7 14 2 9 9 9 12 2"/></svg>
      {%- when 'check' -%}
        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
      {%- when 'heart' -%}
        <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    {%- endcase -%}
  </span>
  {%- if block.settings.title != blank -%}
    <p class="pdp-trust__title">{{ block.settings.title }}</p>
  {%- endif -%}
  {%- if block.settings.text != blank -%}
    <p class="pdp-trust__text">{{ block.settings.text }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.trust_badge.name",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks.trust_badge.settings.icon",
      "options": [
        { "value": "return", "label": "t:blocks.trust_badge.options.return" },
        { "value": "lock", "label": "t:blocks.trust_badge.options.lock" },
        { "value": "truck", "label": "t:blocks.trust_badge.options.truck" },
        { "value": "leaf", "label": "t:blocks.trust_badge.options.leaf" },
        { "value": "star", "label": "t:blocks.trust_badge.options.star" },
        { "value": "check", "label": "t:blocks.trust_badge.options.check" },
        { "value": "heart", "label": "t:blocks.trust_badge.options.heart" }
      ],
      "default": "check"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:blocks.trust_badge.settings.title",
      "default": "Trust badge"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks.trust_badge.settings.text",
      "default": "Short subtitle"
    }
  ]
}
{% endschema %}
