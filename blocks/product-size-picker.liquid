{% doc %}
  Size picker. Includes optional size-guide link (page or URL) and a
  favorite/wishlist toggle in the heading row.

  @example
  {% content_for 'block', type: 'product-size-picker', id: 'size' %}
{% enddoc %}

{%- liquid
  assign size_option = null
  assign candidates = block.settings.option_name | downcase | split: ','
  if product != blank
    for opt in product.options_with_values
      assign opt_name_lower = opt.name | downcase
      for raw in candidates
        assign needle = raw | strip
        if needle != blank
          if opt_name_lower == needle or opt_name_lower contains needle
            assign size_option = opt
            break
          endif
        endif
      endfor
      if size_option != blank
        break
      endif
    endfor
  endif
  assign current_variant = product.selected_or_first_available_variant
  assign current_size = null
  if size_option != blank
    case size_option.position
      when 1
        assign current_size = current_variant.option1
      when 2
        assign current_size = current_variant.option2
      when 3
        assign current_size = current_variant.option3
    endcase
  endif

  assign guide_url = null
  if block.settings.size_guide_link != blank
    assign guide_url = block.settings.size_guide_link
  elsif block.settings.size_guide_page != blank
    assign guide_url = block.settings.size_guide_page.url
  endif
-%}

<div class="pdp-size-wrap" {{ block.shopify_attributes }}>
  <div class="pdp-size__head">
    {%- if size_option != blank -%}
      <div class="pdp-size__label">
        <span class="pdp-size__label-name">{{ size_option.name }}:</span>
        <span data-option-current>{{ current_size }}</span>
      </div>
    {%- else -%}
      <div class="pdp-size__label">
        <span class="pdp-size__label-name">{{ block.settings.option_name }}</span>
      </div>
    {%- endif -%}

    <div class="pdp-size__actions">
      {%- if guide_url != blank -%}
        <a class="pdp-size__guide-link" href="{{ guide_url }}">
          {{ block.settings.size_guide_text }}
        </a>
      {%- endif -%}

      {%- if block.settings.show_favorite -%}
        <favorite-toggle data-product-id="{{ product.id | default: 'placeholder' }}">
          <button
            type="button"
            class="pdp-favorite"
            aria-pressed="false"
            aria-label="{{ 'products.favorite.toggle' | t }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
        </favorite-toggle>
      {%- endif -%}
    </div>
  </div>

  {%- if size_option != blank -%}
    <option-selector
      class="pdp-size"
      data-option-position="{{ size_option.position }}"
      data-option-name="{{ size_option.name }}"
    >
      <div class="pdp-size__options">
        {%- for value in size_option.values -%}
          {%- liquid
            assign size_variant = null
            for v in product.variants
              assign v_size = v.option1
              if size_option.position == 2
                assign v_size = v.option2
              elsif size_option.position == 3
                assign v_size = v.option3
              endif
              if v_size == value
                assign size_variant = v
                break
              endif
            endfor
            assign is_active = false
            if value == current_size
              assign is_active = true
            endif
            assign is_unavailable = true
            if size_variant and size_variant.available
              assign is_unavailable = false
            endif
          -%}
          <button
            type="button"
            class="pdp-size__option{% if is_active %} is-active{% endif %}{% if is_unavailable %} is-unavailable{% endif %}"
            data-option-value="{{ value | escape }}"
            aria-pressed="{{ is_active }}"
            {% if is_unavailable %}disabled{% endif %}
          >
            {{ value }}
          </button>
        {%- endfor -%}
      </div>
    </option-selector>
  {%- else -%}
    {%- comment -%} Editor placeholder when no product or no matching option {%- endcomment -%}
    <div class="pdp-size">
      <div class="pdp-size__options">
        <span class="pdp-size__option is-active">XS</span>
        <span class="pdp-size__option">S</span>
        <span class="pdp-size__option">M</span>
        <span class="pdp-size__option">L</span>
        <span class="pdp-size__option">XL</span>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.size_picker.name",
  "settings": [
    {
      "type": "text",
      "id": "option_name",
      "label": "t:blocks.size_picker.settings.option_name",
      "default": "Größe, Size, Taille, Talla",
      "info": "t:blocks.size_picker.settings.option_name_info"
    },
    {
      "type": "header",
      "content": "t:blocks.size_picker.headers.guide"
    },
    {
      "type": "text",
      "id": "size_guide_text",
      "label": "t:blocks.size_picker.settings.size_guide_text",
      "default": "Größentabelle"
    },
    {
      "type": "url",
      "id": "size_guide_link",
      "label": "t:blocks.size_picker.settings.size_guide_link"
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "t:blocks.size_picker.settings.size_guide_page",
      "info": "t:blocks.size_picker.settings.size_guide_page_info"
    },
    {
      "type": "header",
      "content": "t:blocks.size_picker.headers.favorite"
    },
    {
      "type": "checkbox",
      "id": "show_favorite",
      "label": "t:blocks.size_picker.settings.show_favorite",
      "default": true
    }
  ],
  "presets": [
    { "name": "t:blocks.size_picker.name" }
  ]
}
{% endschema %}
