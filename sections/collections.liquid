{% comment %}
  List-collections template: editorial grid of all collections.
{% endcomment %}

{{ 'component-collection-card.css' | asset_url | stylesheet_tag }}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .collections-index {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
    --collection-cols: {{ section.settings.columns }};
    --grid-gap: 1rem;
  }
{% endstyle %}

<section class="collections-index section-pad color-scheme color-{{ scheme.id }}">
  <div class="page-width">
    <header class="collections-index__header" data-reveal>
      <p class="eyebrow">{{ 'collections.index_label' | t }}</p>
      <h1>{{ 'collections.title' | t }}</h1>
    </header>

    {%- paginate collections by 12 -%}
      <div class="collection-grid">
        {%- for collection in collections -%}
          {% render 'collection-card', collection: collection %}
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
  .collections-index__header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-block-end: 2rem;
  }

  .collections-index__header h1 {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
