{% comment %}
  Custom section: free canvas for all theme blocks. The presets make each
  major block (Hero, Marquee, Countdown, …) directly addable from the
  "Add section" picker.
{% endcomment %}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .flex-section {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="flex-section section-pad color-scheme color-{{ scheme.id }}">
  {% content_for 'blocks' %}
</section>

{% schema %}
{
  "name": "t:sections.custom.name",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom.name"
    },
    {
      "name": "t:blocks.hero.name",
      "blocks": [{ "type": "hero" }]
    },
    {
      "name": "t:blocks.marquee.name",
      "blocks": [{ "type": "marquee" }]
    },
    {
      "name": "t:blocks.featured_coll.name",
      "blocks": [{ "type": "featured-collection" }]
    },
    {
      "name": "t:blocks.coll_list.name",
      "blocks": [{ "type": "collection-list" }]
    },
    {
      "name": "t:blocks.img_text.name",
      "blocks": [{ "type": "image-with-text" }]
    },
    {
      "name": "t:blocks.countdown.name",
      "blocks": [{ "type": "countdown" }]
    },
    {
      "name": "t:blocks.newsletter.name",
      "blocks": [{ "type": "newsletter" }]
    },
    {
      "name": "t:blocks.quote.name",
      "blocks": [{ "type": "quote" }]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
