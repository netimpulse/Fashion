{
  "name": "fashion-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Fashion Shopify Theme mit Visual-QA-Workflow",
  "scripts": {
    "theme:check": "shopify theme check",
    "theme:push:dev": "shopify theme push -e development --nodelete",
    "qa:visual": "playwright test",
    "qa:full": "npm run theme:check && npm run qa:visual",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@shopify/cli": "latest"
  }
}
