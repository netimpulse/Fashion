{% comment %}
  404 page: giant outlined glitch number, spec-sheet error label, CTAs.
{% endcomment %}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .error-404 {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="error-404 section-pad color-scheme color-{{ scheme.id }}">
  <div class="page-width error-404__inner">
    <p class="eyebrow">{{ '404.label' | t }}</p>
    <p class="error-404__number" aria-hidden="true">
      <span class="error-404__digits">404</span>
      <span class="error-404__digits error-404__digits--ghost">404</span>
    </p>
    <h1 class="error-404__title">{{ '404.title' | t }}</h1>
    <p class="error-404__text">{{ '404.not_found' | t }}</p>
    <div class="error-404__actions">
      <a href="{{ routes.all_products_collection_url }}" class="btn">
        {{ '404.back_to_shopping' | t }}
      </a>
      <a href="{{ routes.root_url }}" class="btn btn--secondary">
        {{ '404.go_home' | t }}
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .error-404__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    min-height: 55vh;
    justify-content: center;
  }

  .error-404__number {
    position: relative;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(7rem, 28vw, 20rem);
    line-height: 0.9;
    margin: 0;
    user-select: none;
  }

  .error-404__digits {
    display: block;
  }

  .error-404__digits--ghost {
    position: absolute;
    inset: 0;
    color: transparent;
    -webkit-text-stroke: 1px currentColor;
    transform: translate(0.04em, -0.04em);
    opacity: 0.35;
    color: var(--color-foreground);
  }

  .error-404__title {
    margin: 0;
  }

  .error-404__text {
    opacity: 0.75;
    max-width: 40ch;
  }

  .error-404__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
