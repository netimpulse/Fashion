{% doc %}
  Inline SVG icon library. All icons are 24x24, stroke-based (currentColor)
  unless noted, decorative by default (aria-hidden).

  @param {string} icon - Icon name (see case below)
  @param {string} [class] - Additional CSS class on the svg

  @example
  {% render 'icon', icon: 'cart' %}
  {% render 'icon', icon: 'chevron-down', class: 'select__chevron' %}
{% enddoc %}

{%- case icon -%}
  {%- when 'menu' -%}
    <svg class="icon icon--menu {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'close' -%}
    <svg class="icon icon--close {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5l14 14M19 5L5 19"/></svg>
  {%- when 'search' -%}
    <svg class="icon icon--search {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21"/></svg>
  {%- when 'account' -%}
