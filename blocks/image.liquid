{% doc %}
  Image block: single image, contained or full-bleed, optional caption + link.
{% enddoc %}

<figure class="block-image{% if block.settings.full_width == false %} page-width{% endif %}" {{ block.shopify_attributes }}>
  {%- capture image_markup -%}
    {%- if block.settings.image != blank -%}
      {%- assign img_alt = block.settings.image.alt | default: block.settings.caption | escape -%}
      {{
        block.settings.image
        | image_url: width: 2400
        | image_tag: alt: img_alt, class: 'block-image__img', loading: 'lazy', sizes: '100vw', widths: '550, 750, 1100, 1500, 2000, 2400'
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'block-image__img block-image__placeholder' }}
    {%- endif -%}
  {%- endcapture -%}

  {%- if block.settings.link != blank -%}
    <a href="{{ block.settings.link }}" class="block-image__link">{{ image_markup }}</a>
  {%- else -%}
    {{ image_markup }}
  {%- endif -%}

  {%- if block.settings.caption != blank -%}
    <figcaption class="block-image__caption eyebrow{% if block.settings.full_width %} page-width{% endif %}">
      {{ block.settings.caption | escape }}
    </figcaption>
  {%- endif -%}
</figure>

{% stylesheet %}
  .block-image {
    margin: 0;
    padding-block: 0.75rem;
  }

  .block-image__img {
    width: 100%;
    height: auto;
  }

  .block-image__link {
    display: block;
  }

  .block-image__caption {
    margin-block-start: 0.6rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.image.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:blocks.image.full_width",
      "default": false
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:blocks.image.caption"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.image.name"
    }
  ]
}
{% endschema %}
