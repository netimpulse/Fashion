{% comment %}
  Contact page section: form + optional contact info column with blocks.
{% endcomment %}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .contact {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="contact section-pad color-scheme color-{{ scheme.id }}">
  <div class="page-width">
    <div class="contact__grid{% if section.blocks.size == 0 %} contact__grid--single{% endif %}">
      <div class="contact__main" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="contact__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="contact__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- form 'contact', class: 'contact__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-status" role="status">
              {% render 'icon', icon: 'check' %}
              {{ 'contact.success' | t }}
            </p>
          {%- elsif form.errors -%}
            <div class="form-status form-status--error" role="alert">
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="contact__row">
            <div class="field">
              <label class="field__label" for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
              <input type="text" id="ContactName-{{ section.id }}" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
            </div>
            <div class="field">
              <label class="field__label" for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }}</label>
              <input type="email" id="ContactEmail-{{ section.id }}" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="ContactSubject-{{ section.id }}">{{ 'contact.subject' | t }}</label>
            <input type="text" id="ContactSubject-{{ section.id }}" name="contact[subject]" value="">
          </div>

          <div class="field">
            <label class="field__label" for="ContactBody-{{ section.id }}">{{ 'contact.message' | t }}</label>
            <textarea id="ContactBody-{{ section.id }}" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="btn contact__submit">{{ 'contact.submit' | t }}</button>
        {%- endform -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <aside class="contact__aside">
          {%- for block in section.blocks -%}
            <div class="contact__info" {{ block.shopify_attributes }}>
              {% render 'icon', icon: block.settings.icon %}
              <div class="contact__info-text">
                {%- if block.settings.label != blank -%}
                  <p class="contact__info-label eyebrow">{{ block.settings.label | escape }}</p>
                {%- endif -%}
                {%- if block.settings.value != blank -%}
                  <div class="contact__info-value rte">{{ block.settings.value }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 990px) {
    .contact__grid {
      grid-template-columns: 3fr 2fr;
      gap: 5rem;
    }

    .contact__grid--single {
      grid-template-columns: minmax(0, 44rem);
      justify-content: center;
    }
  }

  .contact__main {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact__heading {
    margin: 0;
  }

  .contact__text {
    max-width: 55ch;
    opacity: 0.85;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-block-start: 1rem;
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 750px) {
    .contact__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact__submit {
    align-self: flex-start;
  }

  .contact__aside {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.2);
    padding: 1.75rem;
    align-self: start;
  }

  .contact__info {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .contact__info .icon {
    margin-block-start: 0.15rem;
  }

  .contact__info-label {
    margin-block-end: 0.3rem;
  }

  .contact__info-value {
    font-size: 0.95rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact.name",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "t:sections.contact.eyebrow_default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.contact.heading_default"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "t:sections.contact.block_info",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "mail", "label": "t:options.icons.mail" },
            { "value": "phone", "label": "t:options.icons.phone" },
            { "value": "map-pin", "label": "t:options.icons.map_pin" },
            { "value": "truck", "label": "t:options.icons.truck" },
            { "value": "return", "label": "t:options.icons.return" },
            { "value": "info", "label": "t:options.icons.info" }
          ],
          "default": "mail"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.heading"
        },
        {
          "type": "richtext",
          "id": "value",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact.name",
      "blocks": [
        { "type": "info" },
        { "type": "info" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
