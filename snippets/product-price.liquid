{% doc %}
  Renders the price block for a product or variant.

  @param {product} product - The current product
  @param {variant} [variant] - Optional variant. Defaults to product.selected_or_first_available_variant
{% enddoc %}

{%- liquid
  if variant == blank
    assign variant = product.selected_or_first_available_variant
  endif

  assign on_sale = false
  if variant.compare_at_price > variant.price
    assign on_sale = true
    assign discount_amount = variant.compare_at_price | minus: variant.price
    assign discount_pct = discount_amount | times: 100.0 | divided_by: variant.compare_at_price | round
  endif

  assign sold_out = false
  unless variant.available
    assign sold_out = true
  endunless
-%}

<div
  class="price{% if on_sale %} price--on-sale{% endif %}{% if sold_out %} price--sold-out{% endif %}"
  data-price-wrapper
>
  <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
  <span class="price__current" data-price>
    {{ variant.price | money }}
  </span>

  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
    <s class="price__compare" data-compare-price>
      {{ variant.compare_at_price | money }}
    </s>
    <span class="price__badge" data-discount-badge>
      -{{ discount_pct }}%
    </span>
  {%- endif -%}

  {%- if sold_out -%}
    <span class="price__sold-out" data-sold-out-label>
      {{ 'products.product.sold_out' | t }}
    </span>
  {%- endif -%}
</div>
