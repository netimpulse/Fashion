{% comment %}
  Product recommendations ("You may also like"). Content is loaded through the
  Product Recommendations API: the custom element fetches this section with
  ?section_id=…&product_id=… and swaps in the rendered result.
{% endcomment %}

{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .recommendations {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
    --grid-cols-desktop: {{ section.settings.columns }};
    --grid-cols-tablet: {{ section.settings.columns | at_most: 3 }};
    --grid-gap: 1rem;
  }
{% endstyle %}

{%- if product != blank -%}
  <product-recommendations
    class="recommendations section-pad color-scheme color-{{ scheme.id }}"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_count }}&intent=related"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="page-width">
        {% render 'section-header', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
        <ul class="product-grid" role="list">
          {%- for rec_product in recommendations.products -%}
            <li>
              {% render 'product-card', card_product: rec_product %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </product-recommendations>
{%- endif -%}

{% javascript %}
  class ProductRecommendations extends HTMLElement {
    connectedCallback() {
      if (this.dataset.loaded) return;
      const observer = new IntersectionObserver(
        (entries, obs) => {
          if (!entries[0].isIntersecting) return;
          obs.disconnect();
          this.loadRecommendations();
        },
        { rootMargin: '0px 0px 400px 0px' }
      );
      observer.observe(this);
    }

    async loadRecommendations() {
      try {
        const response = await fetch(this.dataset.url);
        if (!response.ok) return;
        const html = document.createElement('div');
        html.innerHTML = await response.text();
        const fresh = html.querySelector('product-recommendations');
        if (fresh && fresh.innerHTML.trim().length) {
          this.dataset.loaded = 'true';
          this.innerHTML = fresh.innerHTML;
        }
      } catch (e) {
        /* non-critical */
      }
    }
  }

  if (!customElements.get('product-recommendations')) {
    customElements.define('product-recommendations', ProductRecommendations);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.recommendations.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "t:sections.recommendations.eyebrow_default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.recommendations.heading_default"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "t:sections.recommendations.products_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "t:sections.recommendations.name"
    }
  ]
}
{% endschema %}
