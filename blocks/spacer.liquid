{% doc %}
  Vertical spacer block.
{% enddoc %}

<div class="block-spacer" style="--spacer-height: {{ block.settings.height }}px;" aria-hidden="true" {{ block.shopify_attributes }}></div>

{% stylesheet %}
  .block-spacer {
    height: var(--spacer-height, 40px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.spacer.name",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "t:blocks.spacer.height",
      "min": 8,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:blocks.spacer.name"
    }
  ]
}
{% endschema %}
