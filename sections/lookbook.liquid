{% comment %}
  Lookbook / Shop the Look: editorial image with positionable product hotspots.
  Each hotspot opens a mini product card popover (details/summary — works
  without JS, closes on outside click via <details-disclosure>).
{% endcomment %}

{%- assign scheme = section.settings.color_scheme -%}

{% style %}
  #shopify-section-{{ section.id }} .lookbook {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="lookbook section-pad color-scheme color-{{ scheme.id }}">
  <div class="page-width">
    {% render 'section-header', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}

    <div class="lookbook__stage" data-reveal>
      {%- if section.settings.image != blank -%}
        {%- assign look_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag: alt: look_alt, class: 'lookbook__image', loading: 'lazy', sizes: '(min-width: 990px) 90vw, 100vw', widths: '750, 1100, 1500, 2000, 2400'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook__image lookbook__placeholder' }}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- assign spot_product = block.settings.product -%}
        <details-disclosure
          class="lookbook__spot"
          style="--spot-x: {{ block.settings.pos_x }}%; --spot-y: {{ block.settings.pos_y }}%;"
          {{ block.shopify_attributes }}
        >
          <details class="lookbook__details">
            <summary
              class="lookbook__dot"
              aria-label="{{ spot_product.title | default: section.settings.heading | escape }}"
            >
              {% render 'icon', icon: 'plus' %}
            </summary>
            <div class="lookbook__card{% if block.settings.pos_x > 55 %} lookbook__card--left{% endif %}">
              {%- if spot_product != blank -%}
                <a href="{{ spot_product.url }}" class="lookbook__card-link">
                  {%- if spot_product.featured_media -%}
                    {%- assign spot_alt = spot_product.featured_media.alt | default: spot_product.title | escape -%}
                    {{
                      spot_product.featured_media
                      | image_url: width: 240
                      | image_tag: alt: spot_alt, class: 'lookbook__card-image', loading: 'lazy', widths: '120, 240'
                    }}
                  {%- endif -%}
                  <span class="lookbook__card-info">
                    <span class="lookbook__card-title">{{ spot_product.title | escape }}</span>
                    {% render 'price', product: spot_product, show_range: true, class: 'lookbook__card-price' %}
                    <span class="link-arrow lookbook__card-cta">
                      {{ 'products.product.view_product' | t }}
                      {% render 'icon', icon: 'arrow-up-right' %}
                    </span>
                  </span>
                </a>
              {%- else -%}
                <p class="lookbook__card-empty">{{ 'onboarding.select_product' | t }}</p>
              {%- endif -%}
            </div>
          </details>
        </details-disclosure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .lookbook__stage {
    position: relative;
  }

  .lookbook__image {
    width: 100%;
    height: auto;
  }

  .lookbook__placeholder {
    aspect-ratio: 16 / 9;
  }

  .lookbook__spot {
    position: absolute;
    top: var(--spot-y, 50%);
    left: var(--spot-x, 50%);
    transform: translate(-50%, -50%);
  }

  .lookbook__dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: #111;
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.25);
    transition: transform var(--duration-short) ease;
  }

  .lookbook__dot:hover {
    transform: scale(1.1);
  }

  .lookbook__dot .icon {
    width: 1rem;
    height: 1rem;
    transition: transform var(--duration-short) ease;
  }

  .lookbook__details[open] .lookbook__dot .icon {
    transform: rotate(45deg);
  }

  .lookbook__card {
    position: absolute;
    top: 50%;
    left: calc(100% + 0.75rem);
    transform: translateY(-50%);
    z-index: 5;
    width: 15rem;
    background: var(--color-background);
    color: var(--color-foreground);
    border: 1px solid rgba(var(--color-foreground-rgb), 0.15);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.18);
  }

  .lookbook__card--left {
    left: auto;
    right: calc(100% + 0.75rem);
  }

  .lookbook__card-link {
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem;
    text-decoration: none;
  }

  .lookbook__card-image {
    width: 4.5rem;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    flex: none;
  }

  .lookbook__card-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .lookbook__card-title {
    font-size: 0.85rem;
    font-weight: var(--font-body--weight-bold);
    line-height: 1.3;
  }

  .lookbook__card-price {
    font-size: 0.85rem;
  }

  .lookbook__card-cta {
    font-size: 0.68rem;
    margin-block-start: 0.2rem;
  }

  .lookbook__card-empty {
    padding: 0.9rem;
    font-size: 0.85rem;
    margin: 0;
  }

  @media (max-width: 749px) {
    .lookbook__card {
      width: 13rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lookbook__dot,
    .lookbook__dot .icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.lookbook.name",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "t:sections.lookbook.eyebrow_default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.lookbook.heading_default"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "t:sections.lookbook.block_hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:general.product"
        },
        {
          "type": "range",
          "id": "pos_x",
          "label": "t:sections.lookbook.pos_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "pos_y",
          "label": "t:sections.lookbook.pos_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.lookbook.name",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "pos_x": 30,
            "pos_y": 40
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "pos_x": 65,
            "pos_y": 60
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
